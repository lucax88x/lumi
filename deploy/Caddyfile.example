# Add this site to the existing host Caddyfile; preserve its globals and sites.
# Point DNS at the VPS and set PUBLIC_ORIGIN=https://ciaolumi.fyi in Lumi's .env.
# Match the upstream port to LUMI_GATEWAY_PORT (default 18081).
ciaolumi.fyi {
  reverse_proxy 127.0.0.1:18081 {
    flush_interval -1
  }
}
