# Production: copy to .env and fill private values. No trailing slash.
PUBLIC_ORIGIN=https://lumi.example.com
LUMI_PORT=18080
LUMI_GATEWAY_PORT=18081
KEYCLOAK_ADMIN_PORT=19090
KEYCLOAK_ADMIN_ORIGIN=http://localhost:19090
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
OIDC_CLIENT_SECRET=
# Optional email. Enable only after configuring host, sender and credentials.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_AUTH=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
OPENAI_API_KEY=
# Optional Google identity broker; both values are required to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
